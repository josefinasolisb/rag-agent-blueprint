# Example environment configuration. No real values — every variable here
# is a placeholder for the pinned stack (LangGraph, Postgres + pgvector,
# an OpenAI-compatible API, PyMuPDF/Tesseract). Copy to `.env` and fill in
# real values only once the method bodies are actually implemented.

# --- Ingestion ---
# Object storage location for uploaded source files and extracted text.
STORAGE_BUCKET_URL=
# Path to the Tesseract binary, if not on PATH (used by pytesseract).
TESSERACT_CMD=

# --- Moderation ---
# Postgres connection string for ReviewRecord persistence (ModerationStore).
MODERATION_DB_URL=postgresql://user:password@localhost:5432/moderation
# Minimum educational/quality score (0.0-1.0) a document must clear to
# skip manual review. Left blank on purpose — this scaffold does not
# define or measure a real value.
MODERATION_QUALITY_THRESHOLD=
# Model name used by ContentClassifier for structured-output classification.
MODERATION_CLASSIFIER_MODEL=

# --- Indexing / retrieval ---
# Postgres connection string for the pgvector-backed VectorStore.
VECTOR_STORE_DB_URL=postgresql://user:password@localhost:5432/vectors
# Base URL and API key for the OpenAI-compatible embeddings endpoint.
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=
EMBEDDING_DIMENSIONS=

# --- Agent runtime ---
# Base URL and API key for the OpenAI-compatible chat completions endpoint
# used by the agent graph. Never commit a real key here.
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL_NAME=
# Postgres connection string for LangGraph's async checkpointer.
CONVERSATION_STORE_DB_URL=postgresql://user:password@localhost:5432/conversations

# --- Evals ---
# Path to the local dataset used by tool_call_eval.py and judge_eval.py.
EVALS_DATASET_PATH=./src/rag_agent_blueprint/evals/datasets
# Model name used by judge_eval.py — kept separate from LLM_MODEL_NAME so
# the judge is never the same model as the one under test.
JUDGE_MODEL_NAME=

# --- Feedback (proposed, not implemented) ---
# Postgres connection string a future FeedbackStore implementation would use.
FEEDBACK_STORE_DB_URL=postgresql://user:password@localhost:5432/feedback
